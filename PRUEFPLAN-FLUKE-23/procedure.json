      "description": "Aufwärmzeit abgewartet, Umgebungsbedingungen protokolliert",
      "test_mode": "<p>Erst fortfahren, wenn Prüfling und Normal thermisch eingelaufen sind. Der Fluke 5520A meldet seine Betriebsbereitschaft selbst.</p>",
      "config": "TEXT(Y=PASS)",
      "range": null,
      "test_value": null,
      "test_value_p": null,
