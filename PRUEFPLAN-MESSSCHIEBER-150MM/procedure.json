      "test_type": "Manual Test",
      "description": "Schiebersitz über die gesamte Länge gleichmäßig, kein Kippspiel",
      "test_mode": "<p>Schieber über den ganzen Weg führen. Ruckeln oder Klemmen an einer Stelle deutet auf eine verbogene Schiene; Kippspiel erzeugt einen Abbe-Fehler, der mit dem Messabstand wächst.</p>",
      "config": null,
      "range": null,
      "test_value": null,
      "test_value_p": null,
      "test_value_u": null,
      "auxalary": null,
      "resolution": null,
