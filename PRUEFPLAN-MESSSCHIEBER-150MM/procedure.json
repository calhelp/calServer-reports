      "test_type": "Manual Test",
      "description": "Feststellschraube hält den Schieber ohne Anzeigeänderung",
      "test_mode": "<p>Beliebiges Maß einstellen, feststellen, Anzeige vor und nach dem Festziehen vergleichen.</p>",
      "config": null,
      "range": null,
      "test_value": null,
      "test_value_p": null,
