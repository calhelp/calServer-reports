      "test_step": 2.5,
      "test_type": "Manual Test",
      "description": "Beschriftung, Skala und Anzeige vollständig lesbar",
      "test_mode": "<p>Bei digitaler Anzeige auch den Batteriezustand prüfen: eine schwache Batterie zeigt sich zuerst als sporadischer Anzeigesprung.</p>",
      "config": null,
      "range": null,
      "test_value": null,
