      "test_step": 2.1,
      "test_type": "Manual Test",
      "description": "Nullstellung: bei geschlossenen Messflächen zeigt die Anzeige 0,00 mm",
      "test_mode": "<p>Messflächen mit üblicher Messkraft schließen. Bei digitaler Anzeige vor dem Nullen prüfen, ob die Anzeige bereits driftet.</p>",
      "config": null,
      "range": null,
      "test_value": null,
      "test_value_p": null,
      "test_value_u": null,
      "auxalary": null,
      "resolution": null,
      "tolerance": null,
      "uncertainty": null
    },
    {
      "row_number": 7,
      "test_step": 2.2,
      "test_type": "Manual Test",
      "description": "Lichtspaltprüfung der Außenmessflächen: gleichmäßig, kein keilförmiger Spalt",
      "test_mode": "<p>Geschlossene Messflächen gegen eine diffuse Lichtquelle halten. Ein einseitig breiter Spalt bedeutet fehlende Parallelität und erklärt später Abweichungen, die mit der Länge wachsen.</p>",
      "config": null,
      "range": null,
      "test_value": null,
      "test_value_p": null,
      "test_value_u": null,
      "auxalary": null,
      "resolution": null,
      "tolerance": null,
      "uncertainty": null
