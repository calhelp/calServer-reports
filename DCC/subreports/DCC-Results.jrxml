	<variable name="MeasurementDetailsValue" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[(
    $P{MeasurementDetails} != null
    && !$P{MeasurementDetails}.toString().trim().isEmpty()
    && $P{MeasurementDetails}.toString().trim().matches("^-?\\d+$")
) ? Integer.valueOf($P{MeasurementDetails}.toString().trim()) : Integer.valueOf(1)]]></variableExpression>
	</variable>
	<!--
	    Variante 1 ist der Rueckfall, nicht nur der Wert 1. Vorher druckten
	    Kopf und Detailband nur bei `== 1`; jede andere Zahl (Tippfehler im
	    Parameter, eine Variante aus einer neueren Vorlage) liess die
	    Ergebnistabelle komplett aus — ohne Kopf, ohne Zeilen, ohne Hinweis.
	    Auf einem akkreditierten Schein ist eine still verschwundene
	    Messwerttabelle der schlechteste denkbare Ausgang.

	    Der DCC kennt die Kurzform 21 nicht (siehe README: "1/2/3/4"). Sie
	    steht deshalb nicht in der Liste und faellt hier auf Variante 1
	    zurueck, statt wie bisher eine leere Tabelle zu drucken.
	-->
	<variable name="IsBaseVariant" class="java.lang.Boolean" resetType="None">
		<variableExpression><![CDATA[Boolean.valueOf(
    $V{MeasurementDetailsValue} == null
    || !java.util.Arrays.asList(
           Integer.valueOf(2), Integer.valueOf(22),
           Integer.valueOf(3), Integer.valueOf(4)
       ).contains($V{MeasurementDetailsValue})
)]]></variableExpression>
	</variable>
	<!--
	    Sollwert und Messwert stehen je nach Erfassungsweg in einem von zwei
	    Spaltenpaaren: `fixq`/`varq` (Sollwert des Prüfschritts und Ablesung)
	    oder `sys_actual`/`uut_ind` (Wert des Normals und Anzeige des
	    Prüflings). MET/CAL liefert beide Paare; die V2-Messwertaufnahme füllt
	    `sys_actual`/`uut_ind` nur für numerische Schritte mit gesetztem
	    `tol_ref` und lässt sie sonst leer.

	    Jede Layout-Variante band bisher genau ein Paar. Stand der Wert im
	    anderen, blieb die Spalte leer, obwohl die Zeile ihn trug — genau der
	    Fall, in dem der Schein ohne gesetzten Parameter `MeasurementDetails`
	    eine leere Ergebnistabelle druckte. Die folgenden Variablen greifen auf
	    die Schwesterspalte zurück, wenn die eigene leer ist; Präfix und
	    Einheit folgen dabei der Spalte, aus der der Wert stammt. Sind beide
	    Paare gefüllt — der MET/CAL-Fall —, druckt jede Variante unverändert
	    das Paar, das sie schon immer gedruckt hat.
	-->
	<variable name="FixqValue" class="java.lang.String">
		<variableExpression><![CDATA[($F{fixq} != null && !$F{fixq}.trim().isEmpty())
      ? $F{fixq}
      : ($F{sys_actual} == null ? "" : $F{sys_actual})]]></variableExpression>
	</variable>
	<variable name="FixqPrefix" class="java.lang.String">
		<variableExpression><![CDATA[($F{fixq} != null && !$F{fixq}.trim().isEmpty())
      ? ($F{fixq_p} == null ? "" : $F{fixq_p})
      : ($F{sys_actual_p} == null ? "" : $F{sys_actual_p})]]></variableExpression>
	</variable>
	<variable name="FixqUnit" class="java.lang.String">
		<variableExpression><![CDATA[($F{fixq} != null && !$F{fixq}.trim().isEmpty())
      ? ($F{fixq_u} == null ? "" : $F{fixq_u})
      : ($F{sys_actual_u} == null ? "" : $F{sys_actual_u})]]></variableExpression>
	</variable>
	<variable name="SysActualValue" class="java.lang.String">
		<variableExpression><![CDATA[($F{sys_actual} != null && !$F{sys_actual}.trim().isEmpty())
      ? $F{sys_actual}
      : ($F{fixq} == null ? "" : $F{fixq})]]></variableExpression>
	</variable>
	<variable name="SysActualPrefix" class="java.lang.String">
		<variableExpression><![CDATA[($F{sys_actual} != null && !$F{sys_actual}.trim().isEmpty())
      ? ($F{sys_actual_p} == null ? "" : $F{sys_actual_p})
      : ($F{fixq_p} == null ? "" : $F{fixq_p})]]></variableExpression>
	</variable>
	<variable name="SysActualUnit" class="java.lang.String">
		<variableExpression><![CDATA[($F{sys_actual} != null && !$F{sys_actual}.trim().isEmpty())
      ? ($F{sys_actual_u} == null ? "" : $F{sys_actual_u})
      : ($F{fixq_u} == null ? "" : $F{fixq_u})]]></variableExpression>
	</variable>
	<variable name="VarqValue" class="java.lang.String">
		<variableExpression><![CDATA[($F{varq} != null && !$F{varq}.trim().isEmpty())
      ? $F{varq}
      : ($F{uut_ind} == null ? "" : $F{uut_ind})]]></variableExpression>
	</variable>
	<variable name="UutIndValue" class="java.lang.String">
		<variableExpression><![CDATA[($F{uut_ind} != null && !$F{uut_ind}.trim().isEmpty())
      ? $F{uut_ind}
      : ($F{varq} == null ? "" : $F{varq})]]></variableExpression>
	</variable>
	<variable name="VarqPrefix" class="java.lang.String">
		<variableExpression><![CDATA[($F{varq} != null && !$F{varq}.trim().isEmpty())
      ? ($F{varq_p} == null ? "" : $F{varq_p})
      : ($F{uut_ind_p} == null ? "" : $F{uut_ind_p})]]></variableExpression>
	</variable>
	<variable name="VarqUnit" class="java.lang.String">
		<variableExpression><![CDATA[($F{varq} != null && !$F{varq}.trim().isEmpty())
      ? ($F{varq_u} == null ? "" : $F{varq_u})
      : ($F{uut_ind_u} == null ? "" : $F{uut_ind_u})]]></variableExpression>
	</variable>
	<variable name="UutIndPrefix" class="java.lang.String">
		<variableExpression><![CDATA[($F{uut_ind} != null && !$F{uut_ind}.trim().isEmpty())
      ? ($F{uut_ind_p} == null ? "" : $F{uut_ind_p})
      : ($F{varq_p} == null ? "" : $F{varq_p})]]></variableExpression>
	</variable>
	<variable name="UutIndUnit" class="java.lang.String">
		<variableExpression><![CDATA[($F{uut_ind} != null && !$F{uut_ind}.trim().isEmpty())
      ? ($F{uut_ind_u} == null ? "" : $F{uut_ind_u})
      : ($F{varq_u} == null ? "" : $F{varq_u})]]></variableExpression>
	</variable>
	<!--
	    Wert, SI-Vorsatz und Einheit einer Messgroesse zu einer Zelle
	    zusammensetzen. Dieselbe Regel fuer jede Wertespalte jeder Variante,
	    statt wie bisher je Zelle eine eigene:

	    - Traegt der Wert die Einheit schon im Text ("10 V", "i.O."), kommt
	      nichts dazu. Geprueft wird das am Rest hinter der Zahl, nicht am
	      ganzen Text. Das "E" der Exponentialschreibweise ist ein Buchstabe:
	      die alte Pruefung `.matches(".*\p{L}.*")` hielt "1.2E5" fuer eine
	      Angabe mit Einheit und liess die Einheit weg.
	    - Vorsatz und Einheit stehen zusammen ("9.9 mg"), nicht durch ein
	      Leerzeichen getrennt ("9.9 m g"). Der SI-Vorsatz ist Teil des
	      Einheitenzeichens (SI-Broschuere, Abschnitt 3).

	    Variante 1 nutzt diese Variablen bewusst nicht: sie ist die
	    Basisdarstellung und druckt die Rohwerte, so wie sie es immer getan
	    hat (siehe README, Abschnitt 5.2).
	-->
	<variable name="FixqDisplay" class="java.lang.String">
		<variableExpression><![CDATA[(
              $V{FixqValue} == null || $V{FixqValue}.trim().isEmpty()
              ? ""
              : (
                  $V{FixqValue}.trim().replaceAll("(?<=\\d),(?=\\d)", ".")
                + (
                    $V{FixqValue}.trim().replaceFirst("^[+-]?\\d+([.,]\\d+)?([eE][+-]?\\d+)?", "").matches(".*\\p{L}.*")
                    ? ""
                    : (
                        (($V{FixqPrefix} == null ? "" : $V{FixqPrefix}.trim()) + ($V{FixqUnit} == null ? "" : $V{FixqUnit}.trim())).isEmpty()
                        ? ""
                        : " " + ($V{FixqPrefix} == null ? "" : $V{FixqPrefix}.trim()) + ($V{FixqUnit} == null ? "" : $V{FixqUnit}.trim())
                      )
                  )
                )
              ).trim().replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="VarqDisplay" class="java.lang.String">
		<variableExpression><![CDATA[(
              $V{VarqValue} == null || $V{VarqValue}.trim().isEmpty()
              ? ""
              : (
                  $V{VarqValue}.trim().replaceAll("(?<=\\d),(?=\\d)", ".")
                + (
                    $V{VarqValue}.trim().replaceFirst("^[+-]?\\d+([.,]\\d+)?([eE][+-]?\\d+)?", "").matches(".*\\p{L}.*")
                    ? ""
                    : (
                        (($V{VarqPrefix} == null ? "" : $V{VarqPrefix}.trim()) + ($V{VarqUnit} == null ? "" : $V{VarqUnit}.trim())).isEmpty()
                        ? ""
                        : " " + ($V{VarqPrefix} == null ? "" : $V{VarqPrefix}.trim()) + ($V{VarqUnit} == null ? "" : $V{VarqUnit}.trim())
                      )
                  )
                )
              ).trim().replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="SysActualDisplay" class="java.lang.String">
		<variableExpression><![CDATA[(
              $V{SysActualValue} == null || $V{SysActualValue}.trim().isEmpty()
              ? ""
              : (
                  $V{SysActualValue}.trim().replaceAll("(?<=\\d),(?=\\d)", ".")
                + (
                    $V{SysActualValue}.trim().replaceFirst("^[+-]?\\d+([.,]\\d+)?([eE][+-]?\\d+)?", "").matches(".*\\p{L}.*")
                    ? ""
                    : (
                        (($V{SysActualPrefix} == null ? "" : $V{SysActualPrefix}.trim()) + ($V{SysActualUnit} == null ? "" : $V{SysActualUnit}.trim())).isEmpty()
                        ? ""
                        : " " + ($V{SysActualPrefix} == null ? "" : $V{SysActualPrefix}.trim()) + ($V{SysActualUnit} == null ? "" : $V{SysActualUnit}.trim())
                      )
                  )
                )
              ).trim().replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="UutIndDisplay" class="java.lang.String">
		<variableExpression><![CDATA[(
              $V{UutIndValue} == null || $V{UutIndValue}.trim().isEmpty()
              ? ""
              : (
                  $V{UutIndValue}.trim().replaceAll("(?<=\\d),(?=\\d)", ".")
                + (
                    $V{UutIndValue}.trim().replaceFirst("^[+-]?\\d+([.,]\\d+)?([eE][+-]?\\d+)?", "").matches(".*\\p{L}.*")
                    ? ""
                    : (
                        (($V{UutIndPrefix} == null ? "" : $V{UutIndPrefix}.trim()) + ($V{UutIndUnit} == null ? "" : $V{UutIndUnit}.trim())).isEmpty()
                        ? ""
                        : " " + ($V{UutIndPrefix} == null ? "" : $V{UutIndPrefix}.trim()) + ($V{UutIndUnit} == null ? "" : $V{UutIndUnit}.trim())
                      )
                  )
                )
              ).trim().replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="LowerLimitDisplay" class="java.lang.String">
		<variableExpression><![CDATA[(
              $F{lower_limit} == null || $F{lower_limit}.trim().isEmpty()
              ? ""
              : (
                  $F{lower_limit}.trim().replaceAll("(?<=\\d),(?=\\d)", ".")
                + (
                    $F{lower_limit}.trim().replaceFirst("^[+-]?\\d+([.,]\\d+)?([eE][+-]?\\d+)?", "").matches(".*\\p{L}.*")
                    ? ""
                    : (
                        (($F{lower_limit_p} == null ? "" : $F{lower_limit_p}.trim()) + ($F{lower_limit_u} == null ? "" : $F{lower_limit_u}.trim())).isEmpty()
                        ? ""
                        : " " + ($F{lower_limit_p} == null ? "" : $F{lower_limit_p}.trim()) + ($F{lower_limit_u} == null ? "" : $F{lower_limit_u}.trim())
                      )
                  )
                )
              ).trim().replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="UpperLimitDisplay" class="java.lang.String">
		<variableExpression><![CDATA[(
              $F{upper_limit} == null || $F{upper_limit}.trim().isEmpty()
              ? ""
              : (
                  $F{upper_limit}.trim().replaceAll("(?<=\\d),(?=\\d)", ".")
                + (
                    $F{upper_limit}.trim().replaceFirst("^[+-]?\\d+([.,]\\d+)?([eE][+-]?\\d+)?", "").matches(".*\\p{L}.*")
                    ? ""
                    : (
                        (($F{upper_limit_p} == null ? "" : $F{upper_limit_p}.trim()) + ($F{upper_limit_u} == null ? "" : $F{upper_limit_u}.trim())).isEmpty()
                        ? ""
                        : " " + ($F{upper_limit_p} == null ? "" : $F{upper_limit_p}.trim()) + ($F{upper_limit_u} == null ? "" : $F{upper_limit_u}.trim())
                      )
                  )
                )
              ).trim().replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="PosLimit" class="java.lang.String">
		<variableExpression><![CDATA[($F{upper_limit} == null || $F{upper_limit}.trim().isEmpty()
  ? ""
  : $F{upper_limit}.trim()
      + (
          (($F{upper_limit_p} != null && !$F{upper_limit_p}.trim().isEmpty())
        || ($F{upper_limit_u} != null && !$F{upper_limit_u}.trim().isEmpty()))
            ? " " : ""
        )
 ).replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="NegLimit" class="java.lang.String">
		<variableExpression><![CDATA[($F{lower_limit} == null || $F{lower_limit}.trim().isEmpty()
  ? ""
  : $F{lower_limit}.trim()
      + (
          (($F{lower_limit_p} != null && !$F{lower_limit_p}.trim().isEmpty())
        || ($F{lower_limit_u} != null && !$F{lower_limit_u}.trim().isEmpty()))
            ? " " : ""
        )
 ).replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="ToleranceRange" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[(
        $F{lower_limit}!=null && $F{upper_limit}!=null
        && $F{lower_limit}.replace(",", ".").matches("-?\\d+(\\.\\d+)?")
        && $F{upper_limit}.replace(",", ".").matches("-?\\d+(\\.\\d+)?")
        && Math.abs(
             Math.abs(Double.parseDouble($F{lower_limit}.replace(",", "."))) -
             Math.abs(Double.parseDouble($F{upper_limit}.replace(",", ".")))
           ) < 1e-9
      ? ( "± " + $F{upper_limit}.trim().replaceFirst("^[+-]","")
          + ($F{upper_limit_p}==null || $F{upper_limit_p}.trim().isEmpty() ? "" : " " + $F{upper_limit_p}.trim())
          + ($F{upper_limit_u}==null ? "" : $F{upper_limit_u})
        )
      : (
          ($V{NegLimit}==null ? "" : $V{NegLimit}.trim()) + "\n" +
          ($V{PosLimit}==null ? "" : $V{PosLimit}.trim())
          )
      ).replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="RoundedRelError" class="java.lang.String">
		<variableExpression><![CDATA[($F{rel_err}==null || $F{rel_err}.trim().isEmpty())
 ? ""
 : (
     (
       $V{FixqValue} != null
       && !$V{FixqValue}.trim().isEmpty()
       && $V{FixqValue}.replaceAll("[^0-9\\.,\\-+eE]", "").replace(",", ".").matches("[+-]?\\d+(\\.\\d+)?([eE][+-]?\\d+)?")
       && Math.abs(Double.parseDouble($V{FixqValue}.replaceAll("[^0-9\\.,\\-+eE]", "").replace(",", "."))) < 1e-9
     )
     ? "--"
     : (
         $F{rel_err}.replaceAll("[^0-9\\.,\\-+eE]", "").replace(",", ".").matches("[+-]?\\d+(\\.\\d+)?([eE][+-]?\\d+)?")
        ? new java.text.DecimalFormat("0.0",
            new java.text.DecimalFormatSymbols(java.util.Locale.US))
            .format(
                Double.parseDouble(
                  $F{rel_err}.replaceAll("[^0-9\\.,\\-+eE]", "").replace(",", ".")
                )
            )
         : $F{rel_err}
       )
   )]]></variableExpression>
	</variable>
        <variable name="RoundedTolErr" class="java.lang.String">
                <variableExpression><![CDATA[$F{tol_err}==null || $F{tol_err}.trim().isEmpty()
      ? ""
      : (
          $F{tol_err}.replaceAll("[^0-9\\.,\\-+]", "").replace(",", ".").matches("[+-]?\\d+(\\.\\d+)?")
            ? (Double.parseDouble($F{tol_err}.replaceAll("[^0-9\\.,\\-+]", "").replace(",", ".")) > 500
                ? ">500"
                : new java.text.DecimalFormat("0",
                    new java.text.DecimalFormatSymbols(java.util.Locale.US))
                    .format(Double.parseDouble($F{tol_err}.replaceAll("[^0-9\\.,\\-+]", "").replace(",", ".")))
              )
            : $F{tol_err}.trim().replaceAll("(?<=\\d),(?=\\d)", ".")
        )]]></variableExpression>
        </variable>
	<variable name="FormattedUncertainty" class="java.lang.String">
		<variableExpression><![CDATA[($F{exp_uncert_iso_e}==null || $F{exp_uncert_iso_e}.trim().isEmpty())
      ? ""
      : (
          $F{exp_uncert_iso_e}.trim().contains("<sup>")
          ? $F{exp_uncert_iso_e}.trim()
          : (
              $F{exp_uncert_iso_e}.trim().matches(".*\\d\\s*[eE]\\s*[+-]?\\d+.*")
              ? $F{exp_uncert_iso_e}.trim().replaceAll("(?<=\\d)\\s*[eE]\\s*([+-]?\\d+)", " ×10<sup>$1</sup>")
              : $F{exp_uncert_iso_e}.trim()
            )
        )]]></variableExpression>
	</variable>
	<variable name="FormattedUncertaintyIsoP" class="java.lang.String">
		<variableExpression><![CDATA[($F{exp_uncert_iso_p}==null || $F{exp_uncert_iso_p}.trim().isEmpty())
      ? ""
      : (
          $F{exp_uncert_iso_p}.trim().contains("<sup>")
          ? $F{exp_uncert_iso_p}.trim()
          : (
              $F{exp_uncert_iso_p}.trim().matches(".*\\d\\s*[eE]\\s*[+-]?\\d+.*")
              ? $F{exp_uncert_iso_p}.trim().replaceAll("(?<=\\d)\\s*[eE]\\s*([+-]?\\d+)", " ×10<sup>$1</sup>")
              : $F{exp_uncert_iso_p}.trim()
            )
        )]]></variableExpression>
	</variable>
	<variable name="ExpUncertaintyUnit" class="java.lang.String">
		<variableExpression><![CDATA[$F{exp_uncert_u} == null
      ? ""
      : $F{exp_uncert_u}.trim().replaceAll("(?i)°\\s*C", "K")]]></variableExpression>
	</variable>
        <variable name="ExpUncertaintyValue" class="java.lang.String">
                <!--
                    Dezimalkomma zu Punkt, °C zu K — sonst bleibt der Text, wie
                    er in `exp_uncert` steht. Die fruehere Fassung hat den Wert
                    zerlegt (alle Nicht-Ziffern entfernen, Rest wieder
                    anhaengen) und dabei die Exponentialschreibweise mit
                    positivem Exponenten zerstoert: aus "1.2E5" wurde "1.25E5",
                    weil das "E" im ersten Schritt wegfiel und die "5" an die
                    Mantisse rutschte.
                -->
                <variableExpression><![CDATA[$F{exp_uncert} == null
      ? ""
      : $F{exp_uncert}.trim()
          .replaceAll("(?i)°\\s*C", "K")
          .replaceAll("(?<=\\d),(?=\\d)", ".")]]></variableExpression>
        </variable>
	<variable name="ExpUncertaintyDisplay" class="java.lang.String">
		<variableExpression><![CDATA[(
              $V{ExpUncertaintyValue} == null || $V{ExpUncertaintyValue}.trim().isEmpty()
              ? ""
              : (
                  $V{ExpUncertaintyValue}.trim().replaceAll("(?<=\\d),(?=\\d)", ".")
                + (
                    $V{ExpUncertaintyValue}.trim().replaceFirst("^[+-]?\\d+([.,]\\d+)?([eE][+-]?\\d+)?", "").matches(".*\\p{L}.*")
                    ? ""
                    : (
                        (($F{exp_uncert_p} == null ? "" : $F{exp_uncert_p}.trim()) + ($V{ExpUncertaintyUnit} == null ? "" : $V{ExpUncertaintyUnit}.trim())).isEmpty()
                        ? ""
                        : " " + ($F{exp_uncert_p} == null ? "" : $F{exp_uncert_p}.trim()) + ($V{ExpUncertaintyUnit} == null ? "" : $V{ExpUncertaintyUnit}.trim())
                      )
                  )
                )
              ).trim().replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<!--
	    Die erweiterte Messunsicherheit einer Zeile als fertiger Text.

	    Reihenfolge: der aus MET/TEAM uebernommene, bereits formatierte Text
	    (`exp_uncert_iso_e` bzw. `exp_uncert_iso_p`) gewinnt, sofern vorhanden
	    — er traegt seine Einheit selbst. Sonst wird `exp_uncert` mit Vorsatz
	    und Einheit zusammengesetzt wie jede andere Wertespalte auch.

	    Ausnahme Temperatur/Feuchte: dort gilt der eigene Wert in K, nicht der
	    iso-Text; das ist die einzige Stelle, an der die Vorlage die Einheit
	    umrechnet (°C -> K, siehe ExpUncertaintyUnit).

	    Bis hierher setzten beide Variablen den Wert zwar mit Einheit, aber
	    **ohne SI-Vorsatz** zusammen: aus 3.0E-5 mg wurde "3.0E-5 g" — ein
	    Faktor 1000 in der Unsicherheitsangabe eines akkreditierten Scheins.
	-->
	<variable name="DisplayUncertainty" class="java.lang.String">
		<variableExpression><![CDATA[(
          $F{exp_uncert_u} != null
          && ($F{exp_uncert_u}.contains("°C") || $F{exp_uncert_u}.contains("%fF"))
      )
      ? $V{ExpUncertaintyDisplay}
      : (
          $V{FormattedUncertainty} == null || $V{FormattedUncertainty}.trim().isEmpty()
          ? $V{ExpUncertaintyDisplay}
          : $V{FormattedUncertainty}.replaceAll("(?i)ohm","Ω")
        )]]></variableExpression>
	</variable>
	<variable name="DisplayUncertaintyIsoP" class="java.lang.String">
		<variableExpression><![CDATA[(
          $F{exp_uncert_u} != null
          && ($F{exp_uncert_u}.contains("°C") || $F{exp_uncert_u}.contains("%fF"))
      )
      ? $V{ExpUncertaintyDisplay}
      : (
          $V{FormattedUncertaintyIsoP} == null || $V{FormattedUncertaintyIsoP}.trim().isEmpty()
          ? $V{ExpUncertaintyDisplay}
          : $V{FormattedUncertaintyIsoP}.replaceAll("(?i)ohm","Ω")
        )]]></variableExpression>
	</variable>
	<variable name="HasMeasurementData" class="java.lang.Boolean">
		<variableExpression><![CDATA[Boolean.valueOf(
            ($F{fixq} != null && !$F{fixq}.trim().isEmpty())
         || ($F{varq} != null && !$F{varq}.trim().isEmpty())
         || ($F{sys_actual} != null && !$F{sys_actual}.trim().isEmpty())
         || ($F{uut_ind} != null && !$F{uut_ind}.trim().isEmpty())
        )]]></variableExpression>
	</variable>
	<!--
	    Das "*" der Legende bedeutet "Messergebnisse nicht im
	    Akkreditierungsumfang des Kalibrierlaboratoriums" — es markiert also die
	    AUSNAHME, nicht die Regel. Bis hierher setzte die Vorlage es bei
	    `accred = 1`, also genau umgekehrt: auf einem Schein, dessen Zeilen alle
	    akkreditiert waren, trug jede Zeile die Fussnote "nicht im
	    Akkreditierungsumfang".

	    Drei Zustaende, nicht zwei:

	      1 / y / yes / ja / true   -> im Umfang            -> kein Zeichen
	      0 / n / no / nein / false -> nicht im Umfang      -> "*"
	      leer / nicht gesetzt      -> keine Aussage        -> kein Zeichen

	    Der dritte Fall ist der Grund, warum die Abfrage `accred` nicht mehr auf
	    0 zurueckfaellt (`COALESCE(accred, '')`): sonst waere "nie gepflegt"
	    dasselbe wie "ausserhalb des Umfangs", und jede in calServer erfasste
	    Zeile — die Messwertaufnahme schreibt das Feld nicht — bekaeme die
	    Fussnote. Ein Schein behauptet nichts, was niemand erfasst hat.
	-->
	<variable name="AccredMark" class="java.lang.String">
		<variableExpression><![CDATA[$F{accred} == null
      ? ""
      : (
          $F{accred}.toString().trim().toLowerCase()
            .matches("0|n|no|nein|false|f")
          ? "*"
          : ""
        )]]></variableExpression>
	</variable>
