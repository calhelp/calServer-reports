	<style name="UnicodeDefault" isDefault="true" fontName="DejaVu Sans" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
	<parameter name="PrefixTable" class="java.lang.String">
		<parameterDescription><![CDATA[Tabellenpräfix für die Results-Tabelle.]]></parameterDescription>
	</parameter>
	<parameter name="P_CTAG" class="java.lang.String">
		<parameterDescription><![CDATA[Kalibrierungs-ID als Filter für alle Messwerte.]]></parameterDescription>
	</parameter>
        <parameter name="MeasurementDetails" class="java.lang.String">
                <parameterDescription><![CDATA[Steuert das Layout der Messwert-Frames (22 = DCC-Standard, 1/2/3/4 = alternative Layouts). Die Kurzform 21 des DAkkS-Scheins gibt es hier nicht; sie faellt wie jeder unbekannte Wert auf Variante 1 zurueck.]]></parameterDescription>
                <defaultValueExpression><![CDATA["22"]]></defaultValueExpression>
        </parameter>
	<parameter name="ModernResultsHeader" class="java.lang.String">
		<parameterDescription><![CDATA[Umschalter für einen modernen Tabellenkopf ohne umlaufende Rahmen (Y/N).]]></parameterDescription>
		<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
	</parameter>
	<parameter name="Results_end_note" class="java.lang.String">
		<parameterDescription><![CDATA[Textbaustein, der das Ende des Ergebnisberichts markiert.]]></parameterDescription>
		<defaultValueExpression><![CDATA["---Ende des Ergebnisberichts--"]]></defaultValueExpression>
	</parameter>
	<parameter name="Debug" class="java.lang.String" isForPrompting="false">
		<parameterDescription><![CDATA[Interner Schalter für Protokollzwecke (Y/N).]]></parameterDescription>
		<defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT
      COALESCE(remark,'')              AS remark,
      COALESCE(test_desc,'')           AS test_desc,
      COALESCE(test_step2,'')          AS test_step2,
      COALESCE(fixq,'')                AS fixq,
      COALESCE(fixq_p,'')              AS fixq_p,
      COALESCE(fixq_u,'')              AS fixq_u,
      COALESCE(sys_actual,'')          AS sys_actual,
      COALESCE(sys_actual_p,'')        AS sys_actual_p,
      COALESCE(sys_actual_u,'')        AS sys_actual_u,
      COALESCE(varq,'')                AS varq,
      COALESCE(varq_p,'')              AS varq_p,
      COALESCE(varq_u,'')              AS varq_u,
      COALESCE(uut_ind,'')             AS uut_ind,
      COALESCE(uut_ind_p,'')           AS uut_ind_p,
      COALESCE(uut_ind_u,'')           AS uut_ind_u,
      COALESCE(upper_limit,'')         AS upper_limit,
      COALESCE(upper_limit_p,'')       AS upper_limit_p,
      COALESCE(upper_limit_u,'')       AS upper_limit_u,
      COALESCE(lower_limit,'')         AS lower_limit,
      COALESCE(lower_limit_p,'')       AS lower_limit_p,
      COALESCE(lower_limit_u,'')       AS lower_limit_u,
      COALESCE(exp_uncert,'')          AS exp_uncert,
      COALESCE(exp_uncert_p,'')        AS exp_uncert_p,
      COALESCE(exp_uncert_u,'')        AS exp_uncert_u,
      COALESCE(exp_uncert_iso_e,'')    AS exp_uncert_iso_e,
      COALESCE(exp_uncert_iso_p,'')    AS exp_uncert_iso_p,
      COALESCE(tol_err,'')             AS tol_err,
      COALESCE(rel_err,'')             AS rel_err,
      COALESCE(pass_fail,'')           AS pass_fail,
      COALESCE(fsc,'')                 AS Fsc,
      COALESCE(accred, '')             AS accred,
      row_num
    FROM $P!{PrefixTable}results
    WHERE ctag = $P{P_CTAG}
    ORDER BY row_num]]>
	</queryString>
	<field name="remark" class="java.lang.String"/>
	<field name="test_desc" class="java.lang.String"/>
	<field name="test_step2" class="java.lang.String"/>
	<field name="fixq" class="java.lang.String"/>
