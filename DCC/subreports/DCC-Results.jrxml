					<textFieldExpression><![CDATA[($F{pass_fail} == null || $F{pass_fail}.trim().isEmpty())
                || ($F{Fsc} == null
                    ? true
                    : !(
                        $F{Fsc}.toUpperCase().contains("EVAL")
                        || $F{Fsc}.toUpperCase().contains("PICE")
                    )
                )
                ? ""
                : $F{pass_fail}.trim()]]></textFieldExpression>
