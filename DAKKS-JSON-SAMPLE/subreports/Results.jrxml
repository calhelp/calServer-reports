	<variable name="MeasurementDetailsValue" class="java.lang.Integer" resetType="None">
		<variableExpression><![CDATA[(
    $P{MeasurementDetails} != null
    && !$P{MeasurementDetails}.toString().trim().isEmpty()
    && $P{MeasurementDetails}.toString().trim().matches("^-?\\d+$")
) ? Integer.valueOf($P{MeasurementDetails}.toString().trim()) : Integer.valueOf(1)]]></variableExpression>
	</variable>
	<variable name="UseModernHeader" class="java.lang.Boolean" resetType="None">
		<variableExpression><![CDATA[Boolean.valueOf(
    $P{ModernResultsHeader} == null
    || !$P{ModernResultsHeader}.toString().trim().equalsIgnoreCase("N")
)]]></variableExpression>
	</variable>
	<variable name="NominalValue" class="java.lang.String">
		<variableExpression><![CDATA[$F{fixq}==null || $F{fixq}.trim().isEmpty()
      ? ""
      : $F{fixq}.trim().replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="MeasuredValue" class="java.lang.String">
		<variableExpression><![CDATA[$F{varq}==null || $F{varq}.trim().isEmpty()
      ? ""
      : $F{varq}.trim().replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="PosLimit" class="java.lang.String">
		<variableExpression><![CDATA[($F{upper_limit} == null || $F{upper_limit}.trim().isEmpty()
  ? ""
  : $F{upper_limit}.trim()
      + (
          (($F{upper_limit_p} != null && !$F{upper_limit_p}.trim().isEmpty())
        || ($F{upper_limit_u} != null && !$F{upper_limit_u}.trim().isEmpty()))
            ? " " : ""
        )
 ).replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="NegLimit" class="java.lang.String">
		<variableExpression><![CDATA[($F{lower_limit} == null || $F{lower_limit}.trim().isEmpty()
  ? ""
  : $F{lower_limit}.trim()
      + (
          (($F{lower_limit_p} != null && !$F{lower_limit_p}.trim().isEmpty())
        || ($F{lower_limit_u} != null && !$F{lower_limit_u}.trim().isEmpty()))
            ? " " : ""
        )
 ).replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="ToleranceRange" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[(
        $F{lower_limit}!=null && $F{upper_limit}!=null
        && $F{lower_limit}.replace(",", ".").matches("-?\\d+(\\.\\d+)?")
        && $F{upper_limit}.replace(",", ".").matches("-?\\d+(\\.\\d+)?")
        && Math.abs(
             Math.abs(Double.parseDouble($F{lower_limit}.replace(",", "."))) -
             Math.abs(Double.parseDouble($F{upper_limit}.replace(",", ".")))
           ) < 1e-9
      ? ( "± " + $F{upper_limit}.trim().replaceFirst("^[+-]","")
          + ($F{upper_limit_p}==null || $F{upper_limit_p}.trim().isEmpty() ? "" : " " + $F{upper_limit_p}.trim())
          + ($F{upper_limit_u}==null ? "" : $F{upper_limit_u})
        )
      : (
          ($V{NegLimit}==null ? "" : $V{NegLimit}.trim()) + "\n" +
          ($V{PosLimit}==null ? "" : $V{PosLimit}.trim())
          )
      ).replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="RoundedRelError" class="java.lang.String">
		<variableExpression><![CDATA[($F{rel_err}==null || $F{rel_err}.trim().isEmpty())
 ? ""
 : (
     (
       $F{fixq} != null
       && !$F{fixq}.trim().isEmpty()
       && $F{fixq}.replaceAll("[^0-9\\.,\\-+eE]", "").replace(",", ".").matches("[+-]?\\d+(\\.\\d+)?([eE][+-]?\\d+)?")
       && Math.abs(Double.parseDouble($F{fixq}.replaceAll("[^0-9\\.,\\-+eE]", "").replace(",", "."))) < 1e-9
     )
     ? "--"
     : (
         $F{rel_err}.replaceAll("[^0-9\\.,\\-+eE]", "").replace(",", ".").matches("[+-]?\\d+(\\.\\d+)?([eE][+-]?\\d+)?")
        ? new java.text.DecimalFormat("0.0",
            new java.text.DecimalFormatSymbols(java.util.Locale.US))
            .format(
                Double.parseDouble(
                  $F{rel_err}.replaceAll("[^0-9\\.,\\-+eE]", "").replace(",", ".")
                )
            )
         : $F{rel_err}
       )
   )]]></variableExpression>
	</variable>
        <variable name="RoundedTolErr" class="java.lang.String">
                <variableExpression><![CDATA[$F{tol_err}==null || $F{tol_err}.trim().isEmpty()
      ? ""
      : (
          $F{tol_err}.replaceAll("[^0-9\\.,\\-+]", "").replace(",", ".").matches("[+-]?\\d+(\\.\\d+)?")
            ? (Double.parseDouble($F{tol_err}.replaceAll("[^0-9\\.,\\-+]", "").replace(",", ".")) > 500
                ? ">500"
                : new java.text.DecimalFormat("0",
                    new java.text.DecimalFormatSymbols(java.util.Locale.US))
                    .format(Double.parseDouble($F{tol_err}.replaceAll("[^0-9\\.,\\-+]", "").replace(",", ".")))
              )
            : $F{tol_err}.trim().replaceAll("(?<=\\d),(?=\\d)", ".")
        )]]></variableExpression>
        </variable>
	<variable name="FormattedUncertainty" class="java.lang.String">
		<variableExpression><![CDATA[($F{exp_uncert_iso_e}==null || $F{exp_uncert_iso_e}.trim().isEmpty())
      ? ""
      : (
          $F{exp_uncert_iso_e}.trim().contains("<sup>")
          ? $F{exp_uncert_iso_e}.trim()
          : (
              $F{exp_uncert_iso_e}.trim().matches(".*\\d\\s*[eE]\\s*[+-]?\\d+.*")
              ? $F{exp_uncert_iso_e}.trim().replaceAll("(?<=\\d)\\s*[eE]\\s*([+-]?\\d+)", " ×10<sup>$1</sup>")
              : $F{exp_uncert_iso_e}.trim()
            )
        )]]></variableExpression>
	</variable>
	<variable name="FormattedUncertaintyIsoP" class="java.lang.String">
		<variableExpression><![CDATA[($F{exp_uncert_iso_p}==null || $F{exp_uncert_iso_p}.trim().isEmpty())
      ? ""
      : (
          $F{exp_uncert_iso_p}.trim().contains("<sup>")
          ? $F{exp_uncert_iso_p}.trim()
          : (
              $F{exp_uncert_iso_p}.trim().matches(".*\\d\\s*[eE]\\s*[+-]?\\d+.*")
              ? $F{exp_uncert_iso_p}.trim().replaceAll("(?<=\\d)\\s*[eE]\\s*([+-]?\\d+)", " ×10<sup>$1</sup>")
              : $F{exp_uncert_iso_p}.trim()
            )
        )]]></variableExpression>
	</variable>
	<variable name="ExpUncertaintyUnit" class="java.lang.String">
		<variableExpression><![CDATA[$F{exp_uncert_u} == null
      ? ""
      : $F{exp_uncert_u}.trim().replaceAll("(?i)°\\s*C", "K")]]></variableExpression>
	</variable>
        <variable name="ExpUncertaintyValue" class="java.lang.String">
                <variableExpression><![CDATA[$F{exp_uncert} == null
      ? ""
      : (
          $F{exp_uncert}.replaceAll("[^0-9\\.,\\-+]", "").replace(",", ".").matches("[+-]?\\d+(\\.\\d+)?")
            ? (
                $F{exp_uncert}
                  .replaceAll("[^0-9\\.,\\-+]", "")
                  .replaceAll("(?<=\\d),(?=\\d)", ".")
                + $F{exp_uncert}.trim().replaceAll("(?i)°\\s*C", "K").replaceFirst("[+-]?[0-9.,]+", "")
              )
            : $F{exp_uncert}.trim().replaceAll("(?i)°\\s*C", "K")
        )]]></variableExpression>
        </variable>
	<variable name="DisplayUncertainty" class="java.lang.String">
		<variableExpression><![CDATA[(
          $F{exp_uncert_u} != null
          && (
                 $F{exp_uncert_u}.contains("°C")
              || $F{exp_uncert_u}.contains("%fF")
             )
      )
      ? (
            $V{ExpUncertaintyValue}
          + (
                $V{ExpUncertaintyUnit}.isEmpty()
                ? ""
                : (
                      (
                          $V{ExpUncertaintyValue}
                              .endsWith(
                                  (
                                      ($F{exp_uncert_p} == null ? "" : $F{exp_uncert_p}.trim())
                                      + (
                                              $F{exp_uncert_p} == null || $F{exp_uncert_p}.trim().isEmpty()
                                           || $V{ExpUncertaintyUnit}.isEmpty()
                                          ? ""
                                          : " "
                                        )
                                      + $V{ExpUncertaintyUnit}
                                  ).trim()
                              )
                          || (
                                  $V{ExpUncertaintyUnit}.isEmpty()
                                ? false
                                : $V{ExpUncertaintyValue}.endsWith($V{ExpUncertaintyUnit})
                             )
                      )
                      ? ""
                      : " " + $V{ExpUncertaintyUnit}
                  )
            )
        )
        : (
              $V{FormattedUncertainty} == null || $V{FormattedUncertainty}.trim().isEmpty()
              ? (
                    $V{ExpUncertaintyValue}
                  + (
                        $V{ExpUncertaintyUnit}.isEmpty()
                        ? ""
                        : (
                              (
                                  $V{ExpUncertaintyValue}.endsWith(
                                      (
                                          ($F{exp_uncert_p} == null ? "" : $F{exp_uncert_p}.trim())
                                          + (
                                                  $F{exp_uncert_p} == null || $F{exp_uncert_p}.trim().isEmpty()
                                               || $V{ExpUncertaintyUnit}.isEmpty()
                                              ? ""
                                              : " "
                                            )
                                          + $V{ExpUncertaintyUnit}
                                      ).trim()
                                  )
                                  || $V{ExpUncertaintyValue}.endsWith($V{ExpUncertaintyUnit})
                              )
                              ? ""
                              : " " + $V{ExpUncertaintyUnit}
                          )
                    )
                )
              : $V{FormattedUncertainty}
          ).replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="DisplayUncertaintyIsoP" class="java.lang.String">
		<variableExpression><![CDATA[(
            $F{exp_uncert_u} != null
            && (
                   $F{exp_uncert_u}.contains("°C")
              || $F{exp_uncert_u}.contains("%fF")
             )
      )
