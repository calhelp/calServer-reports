                          )
                    )
                )
              : $V{FormattedUncertaintyIsoP}
          ).replaceAll("(?i)ohm","Ω")]]></variableExpression>
	</variable>
	<variable name="HasMeasurementData" class="java.lang.Boolean">
		<variableExpression><![CDATA[Boolean.valueOf(
